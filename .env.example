# Copy this file to .env and fill in only the keys you have.
# .env is listed in .gitignore: never commit your real keys.
# Every *_MODEL line is optional; without it each script uses its default model.

# OpenAI (chatgpt.py) - https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna

# Anthropic Claude (claude.py) - https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# Google Gemini (gemini.py) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# xAI Grok (grok.py) - https://console.x.ai
XAI_API_KEY=
# XAI_MODEL=grok-4.3

# Perplexity (perplexity.py) - https://www.perplexity.ai/account/api
PERPLEXITY_API_KEY=
# PERPLEXITY_PRESET=fast
# PERPLEXITY_MODEL=

# DeepSeek (deepseek.py) - https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Mistral AI (mistral.py) - https://console.mistral.ai
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# Groq (groq.py) - https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter (openrouter.py) - https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/auto
# OPENROUTER_SITE_URL=https://example.com
# OPENROUTER_APP_NAME=My app

# Alibaba Qwen (qwen.py) - https://modelstudio.console.alibabacloud.com
DASHSCOPE_API_KEY=
# QWEN_MODEL=qwen-flash
# DASHSCOPE_API_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions

# Moonshot AI Kimi (kimi.py) - https://platform.kimi.ai
MOONSHOT_API_KEY=
# KIMI_MODEL=kimi-k2.6

# Maritaca AI (maritaca.py) - https://plataforma.maritaca.ai
MARITACA_API_KEY=
# MARITACA_MODEL=sabiazinho-4

# Ollama (ollama.py) - local, no key needed. Set OLLAMA_MODEL to the model you pulled.
# OLLAMA_MODEL=llama3.2
# OLLAMA_API_URL=http://localhost:11434/v1/chat/completions
